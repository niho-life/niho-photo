{
  "name": "niho-photo",
  "version": "0.1.0",
  "private": true,
  "description": "NIHO photoの公開クライアント共通基盤",
  "workspaces": [
    "packages/desktop-account/ts",
    "packages/ui",
    "packages/photo-editing",
    "apps/camera"
  ],
  "scripts": {
    "pretypecheck": "node scripts/ci/guard-local-heavy.mjs typecheck",
    "typecheck": "npm run typecheck --workspaces",
    "pretest": "node scripts/ci/guard-local-heavy.mjs test",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format:check": "node scripts/check-format.mjs",
    "verify:publication": "node scripts/verify-publication.mjs",
    "preverify": "node scripts/ci/guard-local-heavy.mjs verify",
    "verify": "npm run test:ci && npm run verify:publication && npm run format:check && npm run typecheck && npm test && npm run lint",
    "test:ci": "node --test scripts/ci/*.test.mjs",
    "sdk:pack": "node scripts/sdk/pack-release-set.mjs",
    "presdk:build-engine-runtime": "node scripts/ci/guard-local-heavy.mjs sdk:build-engine-runtime",
    "sdk:build-engine-runtime": "node scripts/sdk/build-develop-engine-runtime.mjs",
    "sdk:test": "node --test scripts/sdk/*.test.mjs",
    "sdk:smoke": "node scripts/sdk/smoke-consumer.mjs",
    "sdk:smoke-real-engine": "node scripts/sdk/smoke-real-engine.mjs",
    "precandidate:build": "node scripts/ci/guard-local-heavy.mjs candidate:build",
    "candidate:build": "node scripts/candidate/build-mac-candidate.mjs",
    "candidate:verify": "node scripts/candidate/verify-mac-candidate.mjs",
    "candidate:test": "node --test scripts/candidate/*.test.mjs",
    "release:evidence": "node scripts/ci/release-evidence.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/react19": "npm:@types/react@19.3.0"
  },
  "license": "UNLICENSED"
}
