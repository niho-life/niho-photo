{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node",
      "react/experimental"
    ],
    "paths": {
      "react": [
        "../../node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "../../node_modules/@types/react/*"
      ],
      "react-dom": [
        "../../node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/*": [
        "../../node_modules/@types/react-dom/*"
      ],
      "@radix-ui/react-dialog": [
        "../../node_modules/@radix-ui/react-dialog/dist/index.d.mts"
      ],
      "@radix-ui/react-popover": [
        "../../node_modules/@radix-ui/react-popover/dist/index.d.mts"
      ],
      "@tanstack/react-query": [
        "../../node_modules/@tanstack/react-query/build/modern/index.d.ts"
      ],
      "@tauri-apps/api/*": [
        "../../node_modules/@tauri-apps/api/*"
      ],
      "clsx": [
        "../../node_modules/clsx/clsx.d.mts"
      ],
      "lucide-react": [
        "../../node_modules/lucide-react/dist/lucide-react.d.ts"
      ],
      "niho-ui/*": [
        "../../node_modules/niho-ui/src/*"
      ],
      "tailwind-merge": [
        "../../node_modules/tailwind-merge/dist/types.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ]
}
