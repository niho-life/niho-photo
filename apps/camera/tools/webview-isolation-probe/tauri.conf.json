{
  "$schema": "../../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "webview-isolation-probe",
  "version": "0.0.0",
  "identifier": "life.niho.camera.research.webview-isolation-probe",
  "build": {
    "frontendDist": "page"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: probe-thumb:",
        "connect-src": "'self' ipc: http://ipc.localhost probe-develop:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false
  }
}
