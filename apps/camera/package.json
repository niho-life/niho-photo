{
  "name": "@niho/camera",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "description": "NIHO photo: Macのローカル写真編集アプリ（Tauri 2 + React）",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
