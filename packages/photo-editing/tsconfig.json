{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "react",
      "react-dom",
      "react/experimental"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../photo-library-contract/src/**/*.ts",
    "../photo-library-contract/fixtures/**/*.ts"
  ]
}
